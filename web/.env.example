# Copy to web/.env — names only. Never commit real values.
DATABASE_URL=
AUTH_SECRET=
ADMIN_EMAIL=
POSTBACK_SECRET=
BITLABS_APP_SECRET=
AYET_HMAC_SECRET=
CPX_SECURE_HASH=
AUTH_URL=http://localhost:3000
# Password-reset + contact email. Leave empty to skip sending (pages still work).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# PostHog (optional). Unset = no-op client/server. Never commit the public key value.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
