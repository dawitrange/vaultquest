generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  image         String?
  role          UserRole       @default(USER)
  ageConfirmed  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  ledgerEntries LedgerEntry[]
  redemptions   Redemption[]
  clicks        OfferClick[]
  contactMessages ContactMessage[]
  passwordResetTokens PasswordResetToken[]
  giveawayEntries GiveawayEntry[]
  gameSessions GameSession[]
  botPlayerProfile BotPlayerProfile?
  gameRewardGrants GameRewardGrant[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum LedgerKind {
  EARN
  RELEASE
  REDEEM
  ADJUST
  CLAWBACK
}

enum LedgerStatus {
  PENDING
  POSTED
  VOID
}

model LedgerEntry {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vp          Int
  kind        LedgerKind
  status      LedgerStatus @default(POSTED)
  availableAt DateTime?
  questId     String?
  clickId     String?
  note        String?
  gameSessionId String?
  rewardPolicyVersion String?
  fundingCampaign String?
  createdAt   DateTime     @default(now())
  gameRewardGrant GameRewardGrant?

  @@index([userId, status])
  @@index([userId, availableAt])
  @@index([clickId])
  @@index([gameSessionId])
}

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  FORFEITED
}

enum GamePersona {
  ANALYST
  SHOWBOAT
  NERVOUS
  WILDCARD
}

enum GameRole {
  KEEPER
  CHOOSER
}

enum GameRoundStatus {
  ACTIVE
  COMPLETED
  FORFEITED
}

enum GameCase {
  CASE_A
  CASE_B
}

enum GameRewardStatus {
  BLOCKED
  PENDING
}

model GameSession {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          GameSessionStatus @default(ACTIVE)
  persona         GamePersona
  engineVersion   String
  policyVersion   String
  version         Int               @default(1)
  seed            String
  rngCursor       Int               @default(0)
  state           Json
  humanScore      Int               @default(0)
  botScore        Int               @default(0)
  xpAwarded       Int               @default(0)
  memoryUpdatedAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rounds          GameRound[]
  actions         GameAction[]
  rewardGrant     GameRewardGrant?

  @@index([userId, status])
  @@index([userId, completedAt])
}

model GameRound {
  id          String          @id @default(cuid())
  sessionId   String
  session     GameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  number      Int
  humanRole   GameRole
  humanCase   GameCase
  botCase     GameCase
  keyCase     GameCase
  status      GameRoundStatus @default(ACTIVE)
  publicState Json
  startedAt   DateTime
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  actions     GameAction[]

  @@unique([sessionId, number])
  @@index([sessionId, status])
}

model GameAction {
  id             String      @id @default(cuid())
  sessionId      String
  session        GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundId        String?
  round          GameRound?  @relation(fields: [roundId], references: [id], onDelete: SetNull)
  clientActionId String
  expectedVersion Int
  resultingVersion Int
  kind           String
  payload        Json
  createdAt      DateTime    @default(now())

  @@unique([sessionId, clientActionId])
  @@index([sessionId, createdAt])
  @@index([roundId])
}

model BotPlayerProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedMatches     Int      @default(0)
  totalXp              Int      @default(0)
  rank                 String   @default("Scout")
  cosmetic             String   @default("Brass Starter Case")
  memory               Json
  lastTrainedSessionId String?  @unique
  lastEngineVersion    String
  lastPolicyVersion    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model GameRewardGrant {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId           String           @unique
  session             GameSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rewardPeriod        DateTime
  vp                  Int
  status              GameRewardStatus
  blockReason         String?
  rewardPolicyVersion String
  fundingCampaign     String?
  availableAt         DateTime?
  ledgerEntryId       String?          @unique
  ledgerEntry         LedgerEntry?     @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())

  @@unique([userId, rewardPeriod])
  @@index([userId, createdAt])
  @@index([status])
}

enum RedemptionStatus {
  REQUESTED
  FULFILLING
  FULFILLED
  CANCELLED
}

model Redemption {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku          String
  label        String
  costVp       Int
  status       RedemptionStatus @default(REQUESTED)
  fulfillNote  String?
  deliveryCode String?
  fulfilledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

enum AffiliateCategory {
  offerwall_primary
  offerwall_backup
  survey_wall
  cpa_signup
  cpe_play
}

enum AffiliateHealth {
  healthy
  capped
  disabled
}

model AffiliateLink {
  id         String            @id @default(cuid())
  slug       String            @unique
  partner    String
  url        String
  category   AffiliateCategory
  priority   Int               @default(1)
  status     AffiliateHealth   @default(healthy)
  capDaily   Int?
  clicks     OfferClick[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([category, status, priority])
}

model OfferClick {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  affiliateLinkId String
  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  questId         String?
  credited        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([affiliateLinkId, createdAt])
  @@index([createdAt])
}

model GiveawayEntry {
  id           String   @id @default(cuid())
  campaignSlug String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String
  reason       String
  createdAt    DateTime @default(now())

  @@unique([campaignSlug, userId])
  @@unique([campaignSlug, email])
  @@index([campaignSlug, createdAt])
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

model ContactMessage {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}
